{
  "nodeModulesDir": "auto",
  "minimumDependencyAge": "P14D",
  "tasks": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 ASTRO_DISABLE_UPDATE_CHECK=true deno run --allow-read --allow-write=. --allow-env --allow-sys --allow-ffi --allow-run --allow-net=localhost,127.0.0.1,0.0.0.0,[::] astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 deno run --allow-read --allow-write=. --allow-env --allow-sys --allow-ffi --allow-run --allow-net=localhost,127.0.0.1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 deno run --allow-read --allow-write=. --allow-env --allow-sys --allow-ffi --allow-run --allow-net=localhost,127.0.0.1,0.0.0.0,[::] astro preview",
    "lint": "deno run --allow-read --allow-env eslint .",
    "lint:fix": "deno run --allow-read --allow-write=. --allow-env --allow-sys --allow-ffi eslint . --fix"
  },
  "imports": {
    "@eslint/js": "npm:@eslint/js@10.0.1",
    "eslint": "npm:eslint@10.12.0",
    "globals": "npm:globals@17.13.0",
    "typescript": "npm:typescript@6.0.3",
    "typescript-eslint": "npm:typescript-eslint@8.71.1",
    "eslint-plugin-vue": "npm:eslint-plugin-vue@10.11.1",
    "vue-eslint-parser": "npm:vue-eslint-parser@10.4.1",
    "@astrojs/mdx": "npm:@astrojs/mdx@8.0.2",
    "@astrojs/vue": "npm:@astrojs/vue@7.0.3",
    "@nanostores/vue": "npm:@nanostores/vue@1.0.1",
    "astro": "npm:astro@7.3.5",
    "nanostores": "npm:nanostores@1.0.1",
    "remove-markdown": "npm:remove-markdown@0.6.2",
    "sanitize-html": "npm:sanitize-html@2.17.0",
    "sass": "npm:sass@1.89.2",
    "vue": "npm:vue@3.5.43"
  }
}
