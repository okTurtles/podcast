{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 deno run -P=serve astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 deno run -P astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 deno run -P=serve astro preview",
    "stop-preview": "ASTRO_TELEMETRY_DISABLED=1 deno run -P astro preview stop"
  },
  "permissions": {
    "default": {
      "read": true,
      "write": ["."],
      "env": true,
      "sys": true,
      "ffi": true,
      "run": true,
      "net": ["localhost", "127.0.0.1"]
    },
    "serve": {
      "read": true,
      "write": ["."],
      "env": true,
      "sys": true,
      "ffi": true,
      "run": true,
      "net": ["localhost", "127.0.0.1", "0.0.0.0", "[::]"]
    }
  },
  "imports": {
    "@astrojs/mdx": "npm:@astrojs/mdx@8.0.2",
    "@astrojs/rss": "npm:@astrojs/rss@4.0.19",
    "@astrojs/vue": "npm:@astrojs/vue@7.0.3",
    "@nanostores/vue": "npm:@nanostores/vue@1.0.1",
    "astro": "npm:astro@7.3.5",
    "nanostores": "npm:nanostores@1.0.1",
    "remove-markdown": "npm:remove-markdown@0.6.2",
    "sanitize-html": "npm:sanitize-html@2.17.0",
    "sass": "npm:sass@1.89.2",
    "vue": "npm:vue@3.5.43"
  }
}
